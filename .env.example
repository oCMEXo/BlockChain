# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_NO_QUOTES
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Set after deployment so the mint scripts can find the contracts:
VISIT_CARD_ADDRESS=
CHARACTERS_ADDRESS=

# Recipient wallet for the demo mints:
STUDENT_WALLET=0xYOUR_STUDENT_WALLET

# Metadata URIs (point at your IPFS pin):
VISIT_CARD_TOKEN_URI=ipfs://REPLACE_CID/visit-card.json
CHARACTERS_BASE_URI=ipfs://REPLACE_CID/{id}.json
